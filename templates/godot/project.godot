; Neon Runner — Godot 4.7 project
; Compatibility renderer is mandatory: the Web export cannot use Forward+/Mobile.

config_version=5

[application]

config/name="Neon Runner"
config/description="Third-person cyberpunk vertical slice. Assets authored in Blender."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon=""

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[input_devices]

pointing/emulate_touch_from_mouse=false
